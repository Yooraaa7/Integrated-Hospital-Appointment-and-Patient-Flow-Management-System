<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Care | Queue Ticket</title>
    <link rel="stylesheet" href="../css/kiosk.css">
</head>
<body>

    <main class="ticket-card">
        <img src="../assets/logo.png" alt="The Care Hospital Logo" class="logo-img">

        <p class="system-name">Queue Management System</p>
        <h1>Your Queue Number</h1>

        <!-- Static prototype values. These will become dynamic later. -->
        <div class="queue-number">CD008</div>

        <div class="ticket-details">
            <p><strong>Department:</strong> Cardiology</p>
            <p><strong>Patient Type:</strong> Walk-In</p>
            <p><strong>Patients Ahead:</strong> 4</p>
        </div>

        <p class="ticket-message">
            Please keep your queue number and wait for it to be shown on the department display screen.
        </p>

        <a href="kiosk.html?department=cardiology" class="done-button">Done</a>
    </main>

</body>
</html>
